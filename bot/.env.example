# From the Discord developer portal (Bot > Reset Token).
DISCORD_TOKEN=
# Erlina's Discord user id (Discord settings > Advanced > Developer Mode, then
# long-press her name > Copy User ID).
ERLINA_DISCORD_USER_ID=
# Optional: parents who may also use the bot, as Name:id pairs, e.g.
# Julian:123,Sally:456. They also get a DM if the calendar stops working.
PARENT_DISCORD_IDS=
# Family calendar id (Google Calendar > Family > Settings > Integrate calendar).
FAMILY_CALENDAR_ID=
# Made once by authorize.py on a computer with a browser.
GOOGLE_TOKEN_FILE=token.json
TIMEZONE=Australia/Brisbane
MORNING_TIME=07:00
