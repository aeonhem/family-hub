[Unit]
Description=Family Hub Discord bot
After=network-online.target
Wants=network-online.target

[Service]
User=familyhub
WorkingDirectory=/opt/family-hub/bot
ExecStart=/opt/family-hub/bot/.venv/bin/python bot.py
Restart=always
RestartSec=10
# Can only write its own folder (state.json); nothing else on the server.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/family-hub/bot

[Install]
WantedBy=multi-user.target
